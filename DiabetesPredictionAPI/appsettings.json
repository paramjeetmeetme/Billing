{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "AllowedHosts": "*",
  "MLApiSettings": {
    "BaseUrl": "http://localhost:5000",
    "TimeoutSeconds": 30,
    "RetryAttempts": 3
  },
  "ApiSettings": {
    "MaxFileSizeMB": 10,
    "AllowedFileTypes": ["csv"],
    "RateLimitRequests": 100,
    "RateLimitWindowMinutes": 15
  }
}